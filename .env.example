# Feishu / Lark OAuth (baoxiao). Copy to .env and fill in. Never commit .env.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://baoxiao.xbchen.top/api/auth/feishu/callback

# Optional overrides
# FEISHU_WEB_ORIGIN=https://baoxiao.xbchen.top
# FEISHU_SCOPES=approval:instance:write approval:instance:read offline_access auth:user.id:read contact:user.base:readonly

# Optional: encrypt per-user AI API keys at rest (otherwise FEISHU_APP_SECRET
# is used, or a generated file `.baoxiao-secrets-key` next to the app).
# Do not commit a real value.
# BAOXIAO_SECRETS_KEY=

# Optional local OCR / review fallback (OpenAI-compatible Ollama)
# XIAOMI_OCR_LOCAL_URL=http://127.0.0.1:11434/v1
# XIAOMI_OCR_MODEL=longwayxu/xiaomi-ocr-0:bf16
# INVOICE_REVIEW_MODEL=longwayxu/xiaomi-ocr-0:bf16
