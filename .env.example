# Feishu / Lark OAuth (baoxiao). Copy to .env and fill in. Never commit .env.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://baoxiao.xbchen.top/api/auth/feishu/callback

# Optional overrides
# FEISHU_WEB_ORIGIN=https://baoxiao.xbchen.top
# FEISHU_SCOPES=approval:instance:write approval:instance:read offline_access auth:user.id:read contact:user.base:readonly
